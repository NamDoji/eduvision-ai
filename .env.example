# ============================================================
# EduVision AI — Cấu hình môi trường
# Sao chép file này thành .env rồi điền giá trị thật
# ============================================================

# [BẮT BUỘC] Groq API Key — lấy miễn phí tại https://console.groq.com
# Không có key này, AI sẽ dùng câu trả lời cứng (mock)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Tùy chọn] Google Cloud Vision OCR
# Nếu không có, hệ thống tự fallback về OCR.space rồi Tesseract
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# [Tùy chọn] Bảo vệ endpoint /demo/reset
# Đặt một chuỗi bí mật bất kỳ; để trống = endpoint bị chặn hoàn toàn
# DEMO_RESET_TOKEN=your-secret-token-here
